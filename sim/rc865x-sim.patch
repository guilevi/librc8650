+   a fixed output rate resamples by this; it changes with the formant setting
+   and the real-time playback rate.  */
+int
+m32c_rc865x_dac_period (void)
+{
+  static const int div[4] = { 1, 8, 32, 32 };
+  return (timer_a3.reload + 1) * div[*mem_ptr (0x399) >> 6];
+}
+
+static unsigned long
+raw24 (int addr)
+{
+  return *mem_ptr (addr) | (*mem_ptr (addr + 1) << 8)
+    | (*mem_ptr (addr + 2) << 16);
+}
+
+static void
+raw24_put (int addr, unsigned long v)
+{
+  *mem_ptr (addr) = v & 0xff;
+  *mem_ptr (addr + 1) = (v >> 8) & 0xff;
+  *mem_ptr (addr + 2) = (v >> 16) & 0x0f;
+}
+
+static void
+dma_latch (int ch)
+{
+  int base = 0x20 + ch * 0x10;
+  dma_init[ch].sar = raw24 (base);
+  dma_init[ch].dar = raw24 (base + 4);
+  dma_init[ch].tcr = *mem_ptr (base + 8) | (*mem_ptr (base + 9) << 8);
+}
+
+static void
+dma_service (int trigger)
+{
+  int ch;
+  for (ch = 0; ch < 2; ch++)
+    {
+      int base = 0x20 + ch * 0x10;
+      unsigned char con = *mem_ptr (base + 0xc);
+      unsigned char sl = *mem_ptr (ch ? 0x3ba : 0x3b8);
+      unsigned long sar, dar;
+      int tcr, step;
+
+      if (!(con & 0x08) || (sl & 0x0f) != trigger)
+	continue;
+
+      sar = raw24 (base);
+      dar = raw24 (base + 4);
+      tcr = *mem_ptr (base + 8) | (*mem_ptr (base + 9) << 8);
+      step = (con & 0x01) ? 1 : 2;
+
+      m32c_dma_write = 1;
+      mem_put_qi (dar, *mem_ptr (sar & membus_mask));
+      if (step == 2)
+	mem_put_qi (dar + 1, *mem_ptr ((sar + 1) & membus_mask));
+      m32c_dma_write = 0;
+
+      if (con & 0x10)
+	sar += step;
+      if (con & 0x20)
+	dar += step;
+      if (--tcr < 0)
+	{
+	  if (con & 0x02)	/* repeat: reload counter + forward pointer */
+	    {
+	      tcr = dma_init[ch].tcr;
+	      if (con & 0x10)
+		sar = dma_init[ch].sar;
+	      if (con & 0x20)
+		dar = dma_init[ch].dar;
+	    }
+	  else
+	    *mem_ptr (base + 0xc) = con & ~0x08;	/* one-shot: disable */
+	}
+      raw24_put (base, sar);
+      raw24_put (base + 4, dar);
+      *mem_ptr (base + 8) = tcr & 0xff;
+      *mem_ptr (base + 9) = (tcr >> 8) & 0xff;
+    }
+}
