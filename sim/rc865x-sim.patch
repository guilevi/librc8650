+/* stdin_ready() stays true at EOF, which fed the firmware an endless stream
+   of NULs and drove it into its error state.  Read one byte ahead instead and
+   only assert RI when a byte was genuinely received.  */
+static int rx_have = 0, rx_eof = 0;
+static unsigned char rx_byte;
+
+static int
+rc865x_rx_fetch (void)
+{
+  char c;
+  if (rx_have)
+    return 1;
+  if (rc865x_hook_rx)
+    {
+      unsigned char b;
+      int r = rc865x_hook_rx (&b);
+      if (r < 0)
+	rx_eof = 1;
+      if (r <= 0)
+	return 0;
+      rx_byte = b;
+      rx_have = 1;
+      return 1;
+    }
+  if (rx_eof || !stdin_ready ())
+    return 0;
+  if (read (m32c_console_ifd, &c, 1) != 1)
+    {
+      rx_eof = 1;
+      return 0;
+    }
+  rx_byte = c;
+  rx_have = 1;
+  return 1;
