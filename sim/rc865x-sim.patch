+    int div = (*mem_ptr (0x06) & 0x40) ? 8 : cm1div[*mem_ptr (0x07) >> 6];
+    int cyc = m32c_insn_cpu_cycles () + irq_cycles;
+    f1 = cyc ? cyc * div : m32c_cpi;
+    irq_cycles = 0;
+  }
