+		   (unsigned long) regs.r_pc);
+	  for (i = 0x400; i < 0x430; i++)
+	    fprintf (stderr, " %02x", mem_get_qi (i));
+	  fprintf (stderr, " 12cc:");
+	  for (i = 0x12cc; i < 0x12e0; i++)
+	    fprintf (stderr, " %02x", mem_get_qi (i));
+	  fprintf (stderr, "\n");
+	}
+    }
